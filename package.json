{
  "name": "@sloppy-plugins/sdk-development",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "workspaces": [
    "typescript"
  ],
  "scripts": {
    "build": "npm run build --workspace @sloppy-plugins/sdk",
    "test": "npm test --workspace @sloppy-plugins/sdk",
